# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` esta no .gitignore — nunca versione chaves de API.

# ── Chaves de API ────────────────────────────────────────────
# RPA (modulo4) — classificacao de eventos com Google Gemini
GOOGLE_API_KEY=

# GenAI / RAG (ORBITAL SENTINEL) — LLM via Groq
GROQ_API_KEY=

# ── Banco de dados (usado pelo docker-compose / RPA) ─────────
DATABASE_URL=postgresql://user:password@postgres:5432/gs_rpa

# ── Configuracao geral ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── URLs dos backends lidas pelo frontend (Vite) ─────────────
# Opcional: o frontend ja faz fallback para localhost nestas portas.
VITE_API_BASE_URL=http://localhost:8000
VITE_QUANTUM_API_URL=http://localhost:8001
VITE_VISION_API_URL=http://localhost:8002
VITE_GENAI_API_URL=http://localhost:8003
VITE_NEURO_API_URL=http://localhost:8004
VITE_PLN_API_URL=http://localhost:8005
# Chave de acesso do assistente PLN (SUETERES)
VITE_PLN_API_KEY=sueteres-dev-key
